# --- Supabase (déjà en place) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL publique de l'app (redirections Stripe success/cancel).
# En prod : https://ton-domaine.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Stripe (paiements) ---
# Tant que ces variables ne sont pas définies, le paiement reste dormant
# (l'app fonctionne, le bouton "Passer à Pro" affiche "bientôt disponible").
# 1) Crée un produit + un prix récurrent (abonnement) dans Stripe → colle le Price ID.
# 2) STRIPE_SECRET_KEY = clé secrète (sk_live_… ou sk_test_…).
# 3) STRIPE_WEBHOOK_SECRET = secret du endpoint webhook (whsec_…),
#    endpoint à pointer sur :  {NEXT_PUBLIC_APP_URL}/api/stripe/webhook
#    événements : checkout.session.completed, customer.subscription.*
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Prix de l'abonnement mensuel (récurrent) :
STRIPE_PRICE_ID=
# Prix de l'accès à vie (paiement unique) :
STRIPE_LIFETIME_PRICE_ID=
